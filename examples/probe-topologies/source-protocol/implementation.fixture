spec: rms/implementation/v0.1
module: probe-source-protocol
binding: python
source:
  root: ../source
  public_entrypoint: ../source/machine_probe.fixture
commands:
  probe: python ../source/machine_probe.fixture
architecture:
  shape: domain-engine
  probe:
    protocol: rms/machine-probe/v0.2
    command: probe
    runner: ../source/machine_probe.fixture#probe_machine
    initial_state_function: ../source/machine_probe.fixture#initial_state
  machine:
    name: ProbeSourceMachine
    mode: stateful-transition-machine
    transition_signature: state-and-input
    initial_state: Ready
    types:
      state: ProbeState
      command: ProbeCommand
      event: ProbeEvent
      effect: ProbeEffect
      effect_result: ProbeEffectResult
      reply: ProbeReply
      rejection: ProbeRejection
      transition: ProbeTransition
      transition_record: ProbeTransitionRecord
    states: [Ready, Waiting]
    commands: [Start]
    observed_events: []
    events: [Completed]
    effects: [Work]
    effect_results: [Done, Failed]
    replies: [Completed]
    rejections: [IllegalTransition, WorkFailed]
    effect_protocols: []
    resource_protocols: []
    transition_function: transition
    transition_record_function: transition_record
    transitions:
    - from: Ready
      on: Start
      to: Waiting
      case: StartWork
      effects: [Work]
    - from: Waiting
      on: Done
      to: Ready
      case: FinishWork
      events: [Completed]
      reply: Completed
    - from: Waiting
      on: Start
      to: Waiting
      case: RejectBusy
      rejection: IllegalTransition
    - from: Ready
      on: Done
      to: Ready
      case: RejectUnexpectedResult
      rejection: IllegalTransition
    - from: Waiting
      on: Failed
      to: Waiting
      case: WorkFailed
      rejection: WorkFailed
  roles:
    representation: [../source/machine_probe.fixture]
    transition: [../source/machine_probe.fixture]
    transition_record: [../source/machine_probe.fixture]
    probe_adapter: [../source/machine_probe.fixture]
  public_behavior_bindings:
  - id: start-public
    public_kind: command
    public_name: start
    contract: contracts/start.v1.yaml
    semantic_function: transition
    machine_inputs: [Start]
    machine_outputs: [Work, Completed]
  protocol_bindings:
  - name: work-conversation
    contract: protocols/work.v1.yaml
    participant: source
    mappings:
    - machine_case: StartWork
      message: WorkRequested
      direction: send
    - machine_case: FinishWork
      message: WorkFinished
      direction: receive
semantic_functions:
- id: transition
  symbol: ../source/machine_probe.fixture#transition
  kind: transition
  purity: pure
dependencies:
  allowed_external_packages: []
  allowed_local_packages: []
  local_modules: []
