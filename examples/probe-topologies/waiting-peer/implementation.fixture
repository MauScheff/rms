spec: rms/implementation/v0.1
module: probe-waiting-peer
binding: python
source: {root: ., public_entrypoint: machine_probe.fixture}
commands: {probe: python machine_probe.fixture}
architecture:
  shape: domain-engine
  probe:
    protocol: rms/machine-probe/v0.2
    command: probe
    runner: machine_probe.fixture#probe_machine
    initial_state_function: machine_probe.fixture#initial_state
  machine:
    name: WaitingPeerMachine
    mode: stateful-transition-machine
    transition_signature: state-and-input
    initial_state: Ready
    types: {state: PeerState, command: PeerCommand, rejection: PeerRejection, transition: PeerTransition, transition_record: PeerTransitionRecord}
    states: [Ready, WaitingForPeer]
    commands: [WaitForPeer]
    observed_events: []
    events: []
    effects: []
    effect_results: []
    replies: []
    rejections: [IllegalTransition]
    effect_protocols: []
    resource_protocols: []
    transition_function: transition
    transition_record_function: transition_record
    transitions:
    - {from: Ready, on: WaitForPeer, to: WaitingForPeer, case: EnterPeerWait}
  roles:
    representation: [machine_probe.fixture]
    transition: [machine_probe.fixture]
    transition_record: [machine_probe.fixture]
    probe_adapter: [machine_probe.fixture]
  public_behavior_bindings:
  - id: wait-public
    public_kind: command
    public_name: wait
    contract: contracts/wait.v1.yaml
    semantic_function: transition
    machine_inputs: [WaitForPeer]
    machine_outputs: []
semantic_functions:
- {id: transition, symbol: machine_probe.fixture#transition, kind: transition, purity: pure}
dependencies: {allowed_external_packages: [], allowed_local_packages: [], local_modules: []}
