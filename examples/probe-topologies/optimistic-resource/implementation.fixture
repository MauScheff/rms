spec: rms/implementation/v0.1
module: probe-optimistic-resource
binding: python
source:
  root: .
  public_entrypoint: machine_probe.fixture
commands:
  probe: python machine_probe.fixture
architecture:
  shape: domain-engine
  probe:
    protocol: rms/machine-probe/v0.2
    command: probe
    runner: machine_probe.fixture#probe_machine
    initial_state_function: machine_probe.fixture#initial_state
  machine:
    name: OptimisticResourceMachine
    mode: stateful-transition-machine
    transition_signature: state-and-input
    initial_state: Ready
    types:
      state: CounterState
      command: CounterCommand
      reply: CounterReply
      rejection: CounterRejection
      transition: CounterTransition
      transition_record: CounterTransitionRecord
    states: [Ready]
    commands: [ReadCounter, CommitCounter]
    observed_events: []
    events: []
    effects: []
    effect_results: []
    replies: [Snapshot, CommitApplied, StaleVersion, Duplicate]
    rejections: [IllegalTransition]
    effect_protocols: []
    resource_protocols: []
    transition_function: transition
    transition_record_function: transition_record
    transitions:
    - {from: Ready, on: ReadCounter, to: Ready, case: ReadCounter, reply: Snapshot}
    - {from: Ready, on: CommitCounter, to: Ready, case: ApplyCommit, reply: CommitApplied}
    - {from: Ready, on: CommitCounter, to: Ready, case: RejectStale, reply: StaleVersion}
    - {from: Ready, on: CommitCounter, to: Ready, case: ReportDuplicate, reply: Duplicate}
  roles:
    representation: [machine_probe.fixture]
    transition: [machine_probe.fixture]
    transition_record: [machine_probe.fixture]
    probe_adapter: [machine_probe.fixture]
  public_behavior_bindings:
  - id: counter-public
    public_kind: command
    public_name: counter
    contract: contracts/counter.v1.yaml
    semantic_function: transition
    machine_inputs: [ReadCounter, CommitCounter]
    machine_outputs: [Snapshot, CommitApplied, StaleVersion, Duplicate]
semantic_functions:
- id: transition
  symbol: machine_probe.fixture#transition
  kind: transition
  purity: pure
dependencies:
  allowed_external_packages: []
  allowed_local_packages: []
  local_modules: []
