{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rms:schema:module:v0.1",
  "title": "RMS Module Manifest v0.1",
  "type": "object",
  "required": [
    "spec",
    "module",
    "profiles",
    "owns",
    "provides",
    "requires",
    "invariants",
    "effects",
    "compatibility",
    "verification"
  ],
  "properties": {
    "spec": {
      "const": "rms/module/v0.1"
    },
    "module": {
      "type": "object",
      "required": [
        "name",
        "version",
        "kind",
        "purpose"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "profiles": {
      "type": "array",
      "items": {
        "enum": [
          "core",
          "stateful",
          "distributed",
          "workflow",
          "boundary",
          "monitor"
        ]
      },
      "contains": {
        "const": "core"
      },
      "uniqueItems": true
    },
    "owns": {
      "type": "object",
      "additionalProperties": {
        "type": "array"
      }
    },
    "provides": {
      "$ref": "#/$defs/contractGroups"
    },
    "requires": {
      "$ref": "#/$defs/contractGroups"
    },
    "composition": {
      "type": "object",
      "properties": {
        "contains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/containedModule"
          },
          "uniqueItems": true
        },
        "exports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compositionExport"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "invariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "uniqueItems": true
    },
    "transformations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transformation"
      },
      "uniqueItems": true
    },
    "authorities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authority"
      },
      "uniqueItems": true
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fuzz_targets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "required": [
        "policy"
      ],
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": [
        "laws",
        "contracts",
        "scenarios",
        "boundaries"
      ],
      "properties": {
        "laws": {
          "type": "array"
        },
        "contracts": {
          "type": "array"
        },
        "scenarios": {
          "type": "array"
        },
        "boundaries": {
          "type": "array"
        },
        "runtime": {
          "type": "array"
        },
        "reconciliation": {
          "type": "array"
        },
        "properties": {
          "type": "array"
        },
        "fuzz": {
          "type": "array"
        },
        "delegations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "proves",
              "provider_module",
              "provider_law",
              "provider_property",
              "through_export",
              "evidence"
            ],
            "properties": {
              "proves": { "type": "string", "minLength": 1 },
              "provider_module": { "type": "string", "minLength": 1 },
              "provider_law": { "type": "string", "minLength": 1 },
              "provider_property": { "type": "string", "minLength": 1 },
              "through_export": { "type": "string", "minLength": 1 },
              "evidence": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "hunt_exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["obligation", "reason"],
            "properties": {
              "obligation": {
                "enum": [
                  "generated-input",
                  "boundary-fuzz",
                  "finite-state-exploration",
                  "schedule-fault-exploration",
                  "unsafe-code-analysis",
                  "oracle-mutation",
                  "temporal-violation-search"
                ]
              },
              "reason": { "type": "string", "minLength": 20 }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "rationale": {
      "type": "object",
      "properties": {
        "intent": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namedReference"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namedReference"
          }
        },
        "traces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "operations": {
      "type": "object",
      "additionalProperties": true
    },
    "workflow": {
      "type": "object",
      "additionalProperties": true
    },
    "boundary": {
      "type": "object",
      "additionalProperties": true
    },
    "monitor": {
      "type": "object",
      "properties": {
        "authority": {
          "enum": [
            "observe-only",
            "advisory",
            "enforcing",
            "fail-safe"
          ]
        },
        "inputs": {
          "type": "array"
        },
        "derived": {
          "type": "array"
        },
        "triggers": {
          "type": "array"
        },
        "failure_mode": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "namedReference": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "contract": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "contractGroups": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/namedReference"
        }
      }
    },
    "containedModule": {
      "type": "object",
      "required": [
        "name",
        "visibility"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "internal",
            "public"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "compositionExport": {
      "type": "object",
      "required": [
        "group",
        "name",
        "from"
      ],
      "properties": {
        "group": {
          "enum": [
            "commands",
            "queries",
            "events",
            "capabilities"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "invariant": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "authority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "enum": [
            "representation",
            "constructor",
            "parser",
            "transition",
            "effect-executor",
            "composition"
          ]
        },
        "enforced_by": {
          "type": "string"
        },
        "verified_by": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "effect": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "capability": {
          "type": "string"
        },
        "semantics": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": ["name", "version", "direction", "contract"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
        "version": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["provided", "required", "internal"] },
        "contract": { "type": "string", "minLength": 1 },
        "invariants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "transformation": {
      "type": "object",
      "required": ["name", "input", "output", "semantic_function"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
        "input": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
        "output": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
        "semantic_function": { "type": "string", "minLength": 1 },
        "rejections": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "uniqueItems": true
        },
        "properties": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["id", "kind", "capabilities", "rationale"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
        "kind": { "enum": ["privileged", "unsafe", "foreign"] },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profiles": {
            "contains": {
              "const": "stateful"
            }
          }
        }
      },
      "then": {
        "required": [
          "state"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "profiles": {
            "contains": {
              "const": "distributed"
            }
          }
        }
      },
      "then": {
        "required": [
          "operations"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "profiles": {
            "contains": {
              "const": "workflow"
            }
          }
        }
      },
      "then": {
        "required": [
          "state",
          "workflow",
          "operations"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "profiles": {
            "contains": {
              "const": "boundary"
            }
          }
        }
      },
      "then": {
        "required": [
          "boundary"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "profiles": {
            "contains": {
              "const": "monitor"
            }
          }
        }
      },
      "then": {
        "required": [
          "monitor"
        ]
      }
    }
  ]
}
