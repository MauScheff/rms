{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rms.land/schemas/module-retirement.schema.json",
  "title": "Exact leaf retirement plan or durable historical record",
  "oneOf": [{"$ref": "#/$defs/plan"}, {"$ref": "#/$defs/record"}],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "executable"],
      "properties": {"sha256": {"$ref": "#/$defs/digest"}, "executable": {"type": "boolean"}}
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "repository", "base", "module", "manifest", "reason", "files"],
      "properties": {
        "spec": {"const": "rms/module-retirement-plan/v0.1"},
        "repository": {"type": "string", "minLength": 1},
        "base": {"$ref": "#/$defs/commit"},
        "module": {"type": "string", "minLength": 1},
        "manifest": {"type": "string", "pattern": "^[^/]+/.+/module\\.yaml$|^[^/]+/module\\.yaml$"},
        "reason": {"type": "string", "pattern": "\\S"},
        "files": {
          "type": "object", "required": ["module.yaml"],
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/file"}
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "run_id", "issuing_rms_version", "route_result", "task_sha256", "normalized_intent_sha256", "intent_schema_sha256", "extraction_prompt_version", "repository", "git_head", "lane", "owner_module", "implementation_target", "allowed_action_families", "normalized_target_paths", "scaffold", "receipt_id"],
      "properties": {
        "schema": {"const": "rms/route-receipt/v0.1"},
        "run_id": {"type": "string", "minLength": 1},
        "issuing_rms_version": {"type": "string", "minLength": 1},
        "route_result": {"const": "ready"},
        "task_sha256": {"$ref": "#/$defs/digest"},
        "normalized_intent_sha256": {"$ref": "#/$defs/digest"},
        "intent_schema_sha256": {"$ref": "#/$defs/digest"},
        "extraction_prompt_version": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "git_head": {"$ref": "#/$defs/commit"},
        "lane": {"const": "module-retirement"},
        "owner_module": {"type": "string", "minLength": 1},
        "implementation_target": {"type": "null"},
        "allowed_action_families": {"const": ["retire-module"]},
        "normalized_target_paths": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
        "scaffold": {"type": "null"},
        "repair_authority": {"type": "null"},
        "receipt_id": {"$ref": "#/$defs/digest"}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["spec", "plan", "receipt"],
      "properties": {
        "spec": {"const": "rms/module-retirement/v0.1"},
        "plan": {"$ref": "#/$defs/plan"},
        "receipt": {"$ref": "#/$defs/receipt"}
      }
    }
  }
}
