{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rms:schema:implementation:v0.1",
  "title": "RMS Implementation Binding v0.1",
  "type": "object",
  "required": [
    "spec",
    "module",
    "binding",
    "source",
    "commands",
    "architecture"
  ],
  "properties": {
    "spec": {
      "const": "rms/implementation/v0.1"
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "binding": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "root",
        "public_entrypoint"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "public_entrypoint": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "commands": {
      "type": "object",
      "required": [
        "build",
        "verify"
      ],
      "properties": {
        "build": {
          "type": "string"
        },
        "verify": {
          "type": "string"
        },
        "format": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "architecture": {
      "$ref": "#/$defs/architecture"
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": true
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": true
    },
    "distribution": {
      "type": "object",
      "properties": {
        "reusable": {
          "type": "boolean"
        },
        "public_facade": {
          "type": "string"
        },
        "semantic_package": {
          "type": "object",
          "additionalProperties": true
        },
        "native_package": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "additionalProperties": true
    },
    "semantic_functions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticFunction"
      }
    },
    "generated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "architecture": {
      "type": "object",
      "required": [
        "shape",
        "machine",
        "roles"
      ],
      "properties": {
        "shape": {
          "type": "string"
        },
        "machine": {
          "$ref": "#/$defs/machine"
        },
        "state_type": false,
        "transition_function": false
      },
      "additionalProperties": true
    },
    "machine": {
      "type": "object",
      "required": [
        "name",
        "mode",
        "transition_signature",
        "types",
        "states",
        "commands",
        "observed_events",
        "events",
        "effects",
        "effect_results",
        "replies",
        "rejections",
        "effect_protocols",
        "transition_function",
        "transitions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "stateless-decision-machine",
            "stateful-transition-machine",
            "workflow-effect-machine",
            "boundary-machine",
            "storage-machine",
            "integration-machine",
            "projection-machine"
          ]
        },
        "transition_signature": {
          "enum": [
            "input-only",
            "state-and-input"
          ]
        },
        "types": {
          "$ref": "#/$defs/machineTypes"
        },
        "states": {
          "$ref": "#/$defs/identifierList"
        },
        "commands": {
          "$ref": "#/$defs/identifierList"
        },
        "observed_events": {
          "$ref": "#/$defs/identifierList"
        },
        "events": {
          "$ref": "#/$defs/identifierList"
        },
        "effects": {
          "$ref": "#/$defs/identifierList"
        },
        "effect_results": {
          "$ref": "#/$defs/identifierList"
        },
        "replies": {
          "$ref": "#/$defs/identifierList"
        },
        "rejections": {
          "$ref": "#/$defs/identifierList"
        },
        "effect_protocols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effectProtocol"
          }
        },
        "transition_function": {
          "type": "string",
          "minLength": 1
        },
        "transitions": {
          "type": "array"
        },
        "stateless_justification": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_justification": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "machineTypes": {
      "type": "object",
      "required": [
        "state",
        "command",
        "event",
        "reply",
        "rejection",
        "transition",
        "transition_record"
      ],
      "properties": {
        "state": { "type": "string" },
        "input": { "type": "string" },
        "command": { "type": "string" },
        "event": { "type": "string" },
        "effect": { "type": "string" },
        "effect_result": { "type": "string" },
        "reply": { "type": "string" },
        "rejection": { "type": "string" },
        "transition": { "type": "string" },
        "transition_record": { "type": "string" }
      },
      "additionalProperties": false
    },
    "identifierList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "effectProtocol": {
      "type": "object",
      "required": [
        "effect",
        "results",
        "atomicity"
      ],
      "properties": {
        "effect": { "type": "string" },
        "results": { "$ref": "#/$defs/identifierList" },
        "executor_role": { "type": "string" },
        "atomicity": {
          "enum": [
            "one-request-one-result",
            "aggregate"
          ]
        },
        "aggregate_justification": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "semanticFunction": {
      "type": "object",
      "required": [
        "id",
        "symbol",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "constructor",
            "parser",
            "decision",
            "transition",
            "projector",
            "adapter",
            "interpreter"
          ]
        },
        "purity": {
          "enum": [
            "pure",
            "effectful",
            "boundary"
          ]
        },
        "discharges": {
          "type": "object",
          "properties": {
            "contracts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "invariants": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "assumptions": {
          "type": "object",
          "properties": {
            "requires": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "maintains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ensures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "evidence": {
          "type": "object",
          "properties": {
            "laws": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contracts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "scenarios": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "boundaries": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "properties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fuzz": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
